<common:BaseWindow x:Class="IPTVChannelManager.EpgGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:IPTVChannelManager.Common"
        xmlns:local="clr-namespace:IPTVChannelManager"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="EPG Guide" MinWidth="900" MinHeight="500"
        Width="1400" Height="700" Icon="tv.ico" ShowInTaskbar="True">

    <common:BaseWindow.Resources>
        <common:ImageConverter x:Key="ImageConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Programme block: normal -->
        <Style x:Key="ProgBlockBorder" TargetType="Border">
            <Setter Property="Background"     Value="#FF2D313E"/>
            <Setter Property="BorderBrush"    Value="#FF1A1C24"/>
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
            <Setter Property="CornerRadius"   Value="2"/>
            <Setter Property="Margin"         Value="0,2,0,2"/>
            <Setter Property="Padding"        Value="6,2"/>
            <Setter Property="ToolTip"        Value="{Binding Tooltip}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentlyAiring}" Value="True">
                    <Setter Property="Background"  Value="#FF1E4A2E"/>
                    <Setter Property="BorderBrush" Value="#FF4CAF50"/>
                    <Setter Property="BorderThickness" Value="2,1,2,1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Row separator line -->
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Height"     Value="1"/>
        </Style>

        <!-- Channel name cell -->
        <Style x:Key="ChannelCell" TargetType="Border">
            <Setter Property="Background"      Value="#FF3D414F"/>
            <Setter Property="BorderBrush"     Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="6,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- Time tick label -->
        <Style x:Key="TimeTickText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAFFFFFF"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </common:BaseWindow.Resources>

    <Grid Background="#FF2D313E">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- Time header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="24"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <!-- Channel name column -->
            <ColumnDefinition Width="*"/>
            <!-- Programme area -->
        </Grid.ColumnDefinitions>

        <!-- ═══ Time header corner — Reload button ══════════════════════════ -->
        <Border Grid.Row="0" Grid.Column="0" Background="#FF292C38"
                BorderBrush="#22FFFFFF" BorderThickness="0,0,1,1">
            <DockPanel VerticalAlignment="Center" Margin="0">
                <Button x:Name="ReloadButton"
                        DockPanel.Dock="Left"
                        Click="ReloadButton_Click"
                        ToolTip="Reload channels &amp; EPG"
                        Width="30" Height="30" Padding="0">
                    <materialDesign:PackIcon Kind="RefreshCircle" Width="18" Height="18"/>
                </Button>
                <TextBlock Text="Channel" Foreground="#AAFFFFFF" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ═══ Time header ticks (scrolls horizontally in sync) ════════════ -->
        <Border Grid.Row="0" Grid.Column="1" Background="#FF292C38"
                BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="TimeHeaderScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <Canvas Width="{x:Static local:EpgGuideViewModel.TotalWidth}" Height="30">
                    <!-- Half-hour minor ticks -->
                    <ItemsControl ItemsSource="{Binding HalfHourMarks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas Height="30"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Bottom"  Value="0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="1" Height="5" Fill="#33FFFFFF" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Label}" Foreground="#66FFFFFF" FontSize="10"
                                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Hour major ticks -->
                    <ItemsControl ItemsSource="{Binding TimeMarks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Height="30"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Bottom"  Value="0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="1" Height="10" Fill="#55FFFFFF" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource TimeTickText}" Margin="3,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
        </Border>

        <!-- ═══ Channel name list (scrolls vertically in sync) ══════════════ -->
        <Border Grid.Row="1" Grid.Column="0" Background="#FF292C38"
                BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <ScrollViewer x:Name="ChannelNamesScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          ScrollChanged="ChannelNamesScroll_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ChannelCell}"
                                    Height="{x:Static local:EpgGuideViewModel.RowHeight}"
                                    MouseLeftButtonDown="ChannelCell_MouseLeftButtonDown"
                                    Tag="{Binding Channel}">
                                <DockPanel VerticalAlignment="Center" LastChildFill="True">
                                    <Image DockPanel.Dock="Left"
                                           Source="{Binding Channel.LogoUrl, Converter={StaticResource ImageConverter}, IsAsync=True}"
                                           Width="48" Height="36" Margin="0,0,6,0"
                                           Stretch="Uniform"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Channel.Name}"
                                                   Foreground="#DDFFFFFF" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Channel.Group}"
                                                   Foreground="#66FFFFFF" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ═══ Programme grid (main scrollable area) ════════════════════════ -->
        <ScrollViewer x:Name="ProgrammeScroll"
                      Grid.Row="1" Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="ProgrammeScroll_ScrollChanged"
                      ClipToBounds="True">
            <Grid>
                <!-- Programme rows -->
                <ItemsControl x:Name="ProgrammeRows" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
                                    Height="{x:Static local:EpgGuideViewModel.RowHeight}"
                                    Width="{x:Static local:EpgGuideViewModel.TotalWidth}">
                                <!-- Programme blocks -->
                                <ItemsControl ItemsSource="{Binding Blocks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{x:Static local:EpgGuideViewModel.TotalWidth}"
                                                    Height="{x:Static local:EpgGuideViewModel.RowHeight}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top"  Value="0"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ProgBlockBorder}"
                                                    Width="{Binding Width}"
                                                    Height="{x:Static local:EpgGuideViewModel.RowHeight}"
                                                    MouseLeftButtonDown="ProgBlock_MouseLeftButtonDown">
                                                <Border.Tag>
                                                    <Binding/>
                                                </Border.Tag>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Title}"
                                                               Foreground="#DDFFFFFF" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding TimeRange}"
                                                               Foreground="#88FFFFFF" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Timeline overlay (vertical red line, non-interactive) -->
                <Canvas Width="{x:Static local:EpgGuideViewModel.TotalWidth}"
                        Height="{Binding TotalRowsHeight}"
                        IsHitTestVisible="False">
                    <!-- Now line -->
                    <Rectangle Canvas.Left="{Binding TimeLineLeft}"
                               Width="2"
                               Height="{Binding TotalRowsHeight}"
                               Fill="#CCFF4444" SnapsToDevicePixels="True"/>
                    <!-- Now label — sticks to top of visible area -->
                    <Border Canvas.Left="{Binding TimeLineLeft}" Canvas.Top="{Binding NowLabelTop}"
                            Background="#CCFF4444" CornerRadius="2" Padding="3,1">
                        <TextBlock x:Name="TimeLineLabel" Text="{Binding NowText}"
                                   Foreground="White" FontSize="9" FontWeight="Bold"/>
                    </Border>
                </Canvas>
            </Grid>
        </ScrollViewer>

        <!-- ═══ Status bar ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Background="#FF1E2028" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#88FFFFFF"
                       FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
        </Border>
        <!-- ═══ Loading overlay ════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2"
              Background="#CC1A1C24" Panel.ZIndex="99"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="52" Height="52"
                             Foreground="#FF4CAF50"/>
                <TextBlock Text="Loading EPG data…"
                           Foreground="#CCFFFFFF" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</common:BaseWindow>
